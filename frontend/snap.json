{
  "source": "build",
  "destination": "build",
  "include": ["/"],
  "minifyHtml": {
    "collapseBoolean": true,
    "removeRedundantAttributes": true,
    "removeRedundantNEWLINE": true
  },
  "nodePort": 45678,
  "loadableComponents": [],
  "asyncScriptFramework": false,
  "crawl": false,
  "preloadImages": false,
  "removeBlobs": true,
  "timeout": 30000,
  "httpPort": 8080,
  "skipThirdPartyRequests": true,
  "publicPath": "/"
}
